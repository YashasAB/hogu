generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  phone     String?
  name      String?
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  reservations Reservation[]
  auth         UserAuth?
  details      UserDetail?

  @@map("users")
}

model Restaurant {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  emoji           String
  latitude        Float
  longitude       Float
  neighborhood    String
  category        String
  isHot           Boolean  @default(false)
  heroImageUrl    String?
  instagramUrl    String?
  website         String?
  email           String?
  createdAt       DateTime @default(now())

  cuisineTags      RestaurantCuisineTag[]
  timeSlots        TimeSlot[]
  reservations     Reservation[]
  auth             RestaurantAuth?

  @@map("restaurants")
}

model CuisineTag {
  id   String @id @default(cuid())
  name String @unique

  restaurants RestaurantCuisineTag[]

  @@map("cuisine_tags")
}

model RestaurantCuisineTag {
  restaurantId String
  cuisineTagId String

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  cuisineTag CuisineTag  @relation(fields: [cuisineTagId], references: [id], onDelete: Cascade)

  @@id([restaurantId, cuisineTagId])
  @@map("restaurant_cuisine_tags")
}

model TimeSlot {
  id           String   @id @default(cuid())
  restaurantId String
  date         String   // YYYY-MM-DD format
  time         String   // HH:mm format
  partySize    Int
  status       String   // AVAILABLE, CUTOFF, FULL
  createdAt    DateTime @default(now())

  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  reservations Reservation[]

  @@unique([restaurantId, date, time, partySize])
  @@map("time_slots")
}

model Reservation {
  id             String   @id @default(cuid())
  userId         String
  restaurantId   String
  slotId         String
  partySize      Int
  status         String   // PENDING, HELD, CONFIRMED, CANCELLED, EXPIRED
  holdExpiresAt  DateTime?
  confirmedAt    DateTime?
  createdAt      DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  slot       TimeSlot   @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@map("reservations")
}

model RestaurantAuth {
  id           String   @id @default(cuid())
  restaurantId String   @unique
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("restaurant_auth")
}

model UserAuth {
  id           String   @id @default(cuid())
  userId       String   @unique
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_auth")
}

model UserDetail {
  id             String  @id @default(cuid())
  userId         String  @unique
  name           String?
  phoneNumber    String?
  email          String?
  preferredHood  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_details")
}

// ======================
// DATING MODULE TABLES
// ======================

model DatingUser {
  id                    String   @id @default(cuid())
  phone_e164            String   @unique @db.VarChar(20)
  password_hash         String
  name                  String   @db.VarChar(100)
  dob                   DateTime

  // Profile text fields
  profession            String?  @db.VarChar(120)
  dreams                String?  @db.VarChar(500)
  five_year_goal        String?  @db.VarChar(500)
  what_i_want_in_partner String? @db.VarChar(500)
  why_partner_would_like_me String? @db.VarChar(500)

  // Single-value preferences (validate in app layer)
  physical_activity     String?
  date_budget           String?
  instagram_handle      String?  @db.VarChar(64)
  diet                  String?
  drinking              String?
  smoking               String?

  // Timestamps
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  @@map("dating_users")
}

model DatingUserPhoto {
  id          String   @id @default(cuid())
  user_id     String
  object_key  String
  object_url  String?
  sort_order  Int      @default(0)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@index([user_id])
  @@map("dating_user_photos")
}

model DatingUserCuisine {
  id        String   @id @default(cuid())
  user_id   String
  cuisine   String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([user_id, cuisine])
  @@index([user_id])
  @@map("dating_user_cuisines")
}

model DatingUserInterest {
  id        String   @id @default(cuid())
  user_id   String
  tag       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([user_id, tag])
  @@index([user_id])
  @@map("dating_user_interests")
}

model DatingUserFirstDateType {
  id              String   @id @default(cuid())
  user_id         String
  first_date_type String
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@unique([user_id, first_date_type])
  @@index([user_id])
  @@map("dating_user_first_date_types")
}

model DatingUserLanguage {
  id        String   @id @default(cuid())
  user_id   String
  lang      String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([user_id, lang])
  @@index([user_id])
  @@map("dating_user_languages")
}

model DatingMatch {
  id            String   @id @default(cuid())
  user1_id      String
  user2_id      String
  status        String   @default("MATCHED") // MATCHED, UNMATCHED
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@unique([user1_id, user2_id])
  @@index([user1_id])
  @@index([user2_id])
  @@map("dating_matches")
}

