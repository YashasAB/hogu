generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  phone     String?
  name      String?
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  reservations Reservation[]
  auth         UserAuth?
  details      UserDetail?

  @@map("users")
}

model Restaurant {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  emoji           String
  latitude        Float
  longitude       Float
  neighborhood    String
  category        String
  isHot           Boolean  @default(false)
  heroImageUrl    String?
  instagramUrl    String?
  website         String?
  email           String?
  createdAt       DateTime @default(now())

  cuisineTags      RestaurantCuisineTag[]
  timeSlots        TimeSlot[]
  reservations     Reservation[]
  auth             RestaurantAuth?

  @@map("restaurants")
}

model CuisineTag {
  id   String @id @default(cuid())
  name String @unique

  restaurants RestaurantCuisineTag[]

  @@map("cuisine_tags")
}

model RestaurantCuisineTag {
  restaurantId String
  cuisineTagId String

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  cuisineTag CuisineTag  @relation(fields: [cuisineTagId], references: [id], onDelete: Cascade)

  @@id([restaurantId, cuisineTagId])
  @@map("restaurant_cuisine_tags")
}

model TimeSlot {
  id           String   @id @default(cuid())
  restaurantId String
  date         String   // YYYY-MM-DD format
  time         String   // HH:mm format
  partySize    Int
  status       String   // AVAILABLE, CUTOFF, FULL
  createdAt    DateTime @default(now())

  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  reservations Reservation[]

  @@unique([restaurantId, date, time, partySize])
  @@map("time_slots")
}

model Reservation {
  id             String   @id @default(cuid())
  userId         String
  restaurantId   String
  slotId         String
  partySize      Int
  status         String   // PENDING, HELD, CONFIRMED, CANCELLED, EXPIRED
  holdExpiresAt  DateTime?
  confirmedAt    DateTime?
  createdAt      DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  slot       TimeSlot   @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@map("reservations")
}

model RestaurantAuth {
  id           String   @id @default(cuid())
  restaurantId String   @unique
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("restaurant_auth")
}

model UserAuth {
  id           String   @id @default(cuid())
  userId       String   @unique
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_auth")
}

model UserDetail {
  id             String  @id @default(cuid())
  userId         String  @unique
  name           String?
  phoneNumber    String?
  email          String?
  preferredHood  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_details")
}

// ======================
// DATING MODULE TABLES
// ======================

// Option tables (admin-managed lookup tables)
model CuisineOption {
  id        String   @id @default(cuid())
  value     String   @unique
  label     String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  users DatingUserCuisine[]

  @@map("cuisine_options")
}

model FirstDateTypeOption {
  id        String   @id @default(cuid())
  value     String   @unique
  label     String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  users DatingUserFirstDateType[]

  @@map("first_date_type_options")
}

model DietOption {
  id        String   @id @default(cuid())
  value     String   @unique
  label     String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("diet_options")
}

model DrinkingOption {
  id        String   @id @default(cuid())
  value     String   @unique
  label     String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("drinking_options")
}

model SmokingOption {
  id        String   @id @default(cuid())
  value     String   @unique
  label     String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("smoking_options")
}

model PhysicalActivityOption {
  id        String   @id @default(cuid())
  value     String   @unique
  label     String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("physical_activity_options")
}

model DateBudgetOption {
  id        String   @id @default(cuid())
  value     String   @unique
  label     String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("date_budget_options")
}

model DatingUser {
  id                    String   @id @default(cuid())
  phoneE164             String   @unique @map("phoneE164")
  passwordHash          String   @map("passwordHash")
  name                  String
  dob                   DateTime

  profession            String?
  dreams                String?
  fiveYearGoal          String?  @map("fiveYearGoal")
  whatIWantInPartner    String?  @map("whatIWantInPartner")
  whyPartnerWouldLikeMe String?  @map("whyPartnerWouldLikeMe")

  physicalActivity      String?  @map("physicalActivity")
  dateBudget            String?  @map("dateBudget")
  instagramHandle       String?  @map("instagramHandle")
  diet                  String?
  drinking              String?
  smoking               String?
  height                String?
  relationshipType      String   @default("serious") @map("relationshipType")

  createdAt             DateTime @default(now()) @map("createdAt")
  updatedAt             DateTime @updatedAt @map("updatedAt")

  // Relations
  photos         DatingUserPhoto[]
  cuisines       DatingUserCuisine[]
  interests      DatingUserInterest[]
  firstDateTypes DatingUserFirstDateType[]
  languages      DatingUserLanguage[]

  @@map("dating_users")
}

model DatingUserPhoto {
  id          String   @id @default(cuid())
  userId      String   @map("userId")
  objectKey   String   @map("objectKey")
  objectUrl   String?  @map("objectUrl")
  sortOrder   Int      @default(0) @map("sortOrder")
  createdAt   DateTime @default(now()) @map("createdAt")
  updatedAt   DateTime @updatedAt @map("updatedAt")

  user DatingUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("dating_user_photos")
}

model DatingUserCuisine {
  id             String   @id @default(cuid())
  userId         String   @map("userId")
  cuisineOptionId String  @map("cuisineOptionId")
  createdAt      DateTime @default(now()) @map("createdAt")
  updatedAt      DateTime @updatedAt @map("updatedAt")

  user          DatingUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  cuisineOption CuisineOption @relation(fields: [cuisineOptionId], references: [id], onDelete: Cascade)

  @@unique([userId, cuisineOptionId])
  @@index([userId])
  @@map("dating_user_cuisines")
}

model DatingUserInterest {
  id        String   @id @default(cuid())
  userId    String   @map("userId")
  tag       String
  createdAt DateTime @default(now()) @map("createdAt")
  updatedAt DateTime @updatedAt @map("updatedAt")

  user DatingUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tag])
  @@index([userId])
  @@map("dating_user_interests")
}

model DatingUserFirstDateType {
  id                   String   @id @default(cuid())
  userId               String   @map("userId")
  firstDateTypeOptionId String  @map("firstDateTypeOptionId")
  createdAt            DateTime @default(now()) @map("createdAt")
  updatedAt            DateTime @updatedAt @map("updatedAt")

  user                DatingUser          @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstDateTypeOption FirstDateTypeOption @relation(fields: [firstDateTypeOptionId], references: [id], onDelete: Cascade)

  @@unique([userId, firstDateTypeOptionId])
  @@index([userId])
  @@map("dating_user_first_date_types")
}

model DatingUserLanguage {
  id        String   @id @default(cuid())
  userId    String   @map("userId")
  lang      String
  createdAt DateTime @default(now()) @map("createdAt")
  updatedAt DateTime @updatedAt @map("updatedAt")

  user DatingUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lang])
  @@index([userId])
  @@map("dating_user_languages")
}

model DatingMatch {
  id            String   @id @default(cuid())
  user1_id      String
  user2_id      String
  status        String   @default("MATCHED") // MATCHED, INTERESTED, SCHEDULING, CONFIRMED, COMPLETED, UNMATCHED
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@unique([user1_id, user2_id])
  @@index([user1_id])
  @@index([user2_id])
  @@map("dating_matches")
}

model AdminMessage {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  fromAdmin   Boolean  @default(true) @map("from_admin")
  content     String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("admin_messages")
}

