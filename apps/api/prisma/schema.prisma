generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  phone     String?
  name      String?
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  reservations Reservation[]
  auth         UserAuth?
  details      UserDetail?

  @@map("users")
}

model Restaurant {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  emoji           String
  latitude        Float
  longitude       Float
  neighborhood    String
  category        String
  isHot           Boolean  @default(false)
  heroImageUrl    String?
  instagramUrl    String?
  website         String?
  email           String?
  createdAt       DateTime @default(now())

  cuisineTags      RestaurantCuisineTag[]
  timeSlots        TimeSlot[]
  reservations     Reservation[]
  auth             RestaurantAuth?

  @@map("restaurants")
}

model CuisineTag {
  id   String @id @default(cuid())
  name String @unique

  restaurants RestaurantCuisineTag[]

  @@map("cuisine_tags")
}

model RestaurantCuisineTag {
  restaurantId String
  cuisineTagId String

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  cuisineTag CuisineTag  @relation(fields: [cuisineTagId], references: [id], onDelete: Cascade)

  @@id([restaurantId, cuisineTagId])
  @@map("restaurant_cuisine_tags")
}

model TimeSlot {
  id           String   @id @default(cuid())
  restaurantId String
  date         String   // YYYY-MM-DD format
  time         String   // HH:mm format
  partySize    Int
  status       String   // AVAILABLE, CUTOFF, FULL
  createdAt    DateTime @default(now())

  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  reservations Reservation[]

  @@unique([restaurantId, date, time, partySize])
  @@map("time_slots")
}

model Reservation {
  id             String   @id @default(cuid())
  userId         String
  restaurantId   String
  slotId         String
  partySize      Int
  status         String   // PENDING, HELD, CONFIRMED, CANCELLED, EXPIRED
  holdExpiresAt  DateTime?
  confirmedAt    DateTime?
  createdAt      DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  slot       TimeSlot   @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@map("reservations")
}

model RestaurantAuth {
  id           String   @id @default(cuid())
  restaurantId String   @unique
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("restaurant_auth")
}

model UserAuth {
  id           String   @id @default(cuid())
  userId       String   @unique
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_auth")
}

model UserDetail {
  id             String  @id @default(cuid())
  userId         String  @unique
  name           String?
  phoneNumber    String?
  email          String?
  preferredHood  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_details")
}

// ======================
// DATING MODULE (scalar-only, no relations/enums)
// ======================

model DatingUser {
  id                    String   @id @default(cuid())
  phoneE164             String   @unique
  passwordHash          String
  name                  String
  dob                   DateTime

  // Profile
  profession            String?
  dreams                String?
  fiveYearGoal          String?
  whatIWantInPartner    String?
  whyPartnerWouldLikeMe String?

  // Single-value preferences (validate in app; suggested sets below)
  // physicalActivity: "RARELY" | "SOMETIMES" | "REGULAR" | "ATHLETE"
  physicalActivity      String?
  // dateBudget: "_500_1000" | "_1000_2500" | "_2500_5000" | "_5000_PLUS"
  dateBudget            String?
  instagramHandle       String?
  // diet: "VEG" | "EGG" | "NON_VEG" | "VEGAN" | "JAIN"
  diet                  String?
  // drinking: "NEVER" | "SOCIALLY" | "OFTEN"
  drinking              String?
  // smoking: "NO" | "SOCIALLY" | "YES"
  smoking               String?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("dating_users")
}

model DatingUserPhoto {
  id          String   @id @default(cuid())
  userId      String                          // logical FK → dating_users.id
  objectKey   String                          // e.g. "dating/photos/<userId>/<uuid>.jpg"
  objectUrl   String?                         // optional public/CDN URL
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId], name: "idx_dating_user_photos_user")
  @@map("dating_user_photos")
}

model DatingUserCuisine {
  id        String   @id @default(cuid())
  userId    String
  cuisine   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, cuisine], name: "uniq_dating_user_cuisine")
  @@index([userId], name: "idx_dating_user_cuisines_user")
  @@map("dating_user_cuisines")
}

model DatingUserInterest {
  id        String   @id @default(cuid())
  userId    String
  tag       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, tag], name: "uniq_dating_user_interest")
  @@index([userId], name: "idx_dating_user_interests_user")
  @@map("dating_user_interests")
}

/*
  First date types — store as STRING so composite uniques stay scalar-only.
  Allowed values (validate in app/validators):
    "COFFEE","QUICK_COCKTAIL","BREAKFAST","LUNCH","DINNER",
    "GO_KARTING","PAINT_DATE","BOWLING","MUSEUM_WALK","LIVE_MUSIC","ICECREAM_WALK"
*/
model DatingUserFirstDateType {
  id            String   @id @default(cuid())
  userId        String
  firstDateType String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, firstDateType], name: "uniq_dating_user_first_date_type")
  @@index([userId], name: "idx_dating_user_first_date_types_user")
  @@map("dating_user_first_date_types")
}

model DatingUserLanguage {
  id        String   @id @default(cuid())
  userId    String
  lang      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, lang], name: "uniq_dating_user_language")
  @@index([userId], name: "idx_dating_user_languages_user")
  @@map("dating_user_languages")
}

