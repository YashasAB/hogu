
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Gender {
  FEMALE
  MALE
  NON_BINARY
  PREFER_NOT_TO_SAY
}

enum MatchStatus {
  NEW
  SCHEDULE
  SCHEDULED
  CANCELLED
}

enum Intent {
  YES
  NO
  MAYBE
  WITHDRAWN
}

enum PhysicalActivity {
  RARELY
  SOMETIMES
  REGULAR
  ATHLETE
}

enum FirstDateType {
  COFFEE
  QUICK_COCKTAIL
  LUNCH
  BREAKFAST
  DINNER
  GO_KARTING
  PAINT_DATE
  BOWLING
  MUSEUM_WALK
  LIVE_MUSIC
  ICECREAM_WALK
}

enum PrefNeighborhood {
  KALYAN_NAGAR
  HSR_LAYOUT
  WHITEFIELD
  CENTRAL_BLR
  INDIRANAGAR
  KORAMANGALA
}

enum SeekingGender {
  FEMALE
  MALE
  NON_BINARY
}

model User {
  id                     BigInt @id @default(autoincrement())
  email                  String @unique
  passwordHash           String
  name                   String
  dob                    DateTime
  gender                 Gender
  city                   String?
  neighborhood           String?
  tz                     String
  instagramHandle        String?
  profession             String?
  dreams                 String?
  fiveYearGoal           String?
  whatIWantInPartner     String?
  whyPartnerWouldLikeMe  String?
  physicalActivity       PhysicalActivity?

  photos                 UserPhoto[]
  cuisines               UserCuisine[]
  interests              UserInterest[]
  firstDateTypes         UserFirstDateType[]
  preferredNeighborhoods UserPreferredNeighborhood[]
  seekingGenders         UserSeekingGender[]
  thread                 MessageThread?

  intents                MatchIntent[]
  availabilities         AvailabilitySlot[]
  matches1               Match[] @relation("matches_user1")
  matches2               Match[] @relation("matches_user2")

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model UserPhoto {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserCuisine {
  userId  BigInt
  cuisine String
  user    User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([userId, cuisine])
}

model UserInterest {
  userId BigInt
  tag    String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([userId, tag])
}

model UserFirstDateType {
  userId BigInt
  type   FirstDateType
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([userId, type])
}

model UserPreferredNeighborhood {
  userId           BigInt
  prefNeighborhood PrefNeighborhood
  user             User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([userId, prefNeighborhood])
}

model UserSeekingGender {
  userId  BigInt
  seeking SeekingGender
  user    User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([userId, seeking])
}

model Match {
  id        BigInt      @id @default(autoincrement())
  userId1   BigInt
  userId2   BigInt
  status    MatchStatus @default(NEW)
  createdAt DateTime    @default(now())

  user1   User                @relation("matches_user1", fields: [userId1], references: [id])
  user2   User                @relation("matches_user2", fields: [userId2], references: [id])
  intents MatchIntent[]
  slots   AvailabilitySlot[]
  booking Booking?
}

model MatchIntent {
  id        BigInt   @id @default(autoincrement())
  matchId   BigInt
  userId    BigInt
  intent    Intent
  note      String?
  createdAt DateTime @default(now())
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([matchId, userId])
}

model AvailabilitySlot {
  id        BigInt   @id @default(autoincrement())
  matchId   BigInt
  userId    BigInt
  date      DateTime
  startTime String
  endTime   String
  tz        String
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Booking {
  id            BigInt   @id @default(autoincrement())
  matchId       BigInt   @unique
  venueId       BigInt?
  venueName     String?
  venueAddress  String?
  startTs       DateTime?
  endTs         DateTime?
  status        String   @default("HELD")
  paymentStatus String   @default("PENDING")
  createdAt     DateTime @default(now())
  match         Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
}

model MessageThread {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]
  createdAt DateTime  @default(now())
}

model Message {
  id         BigInt        @id @default(autoincrement())
  threadId   BigInt
  senderType String
  senderId   BigInt
  body       String?
  attachment String?
  createdAt  DateTime      @default(now())
  thread     MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
}
