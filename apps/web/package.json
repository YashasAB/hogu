{
  "name": "hogu-web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:web": "tsc -b && vite build",
    "build:mobile": "tsc -b && VITE_API_BASE_URL=https://hogu.club vite build --outDir dist-mobile",
    "cap:sync": "cap sync ios",
    "mobile": "tsc -b && VITE_API_BASE_URL=https://hogu.club vite build --outDir dist-mobile && cap sync ios",
    "preview": "vite preview --host 0.0.0.0 --port 5000"
  },
  "dependencies": {
    "@capacitor/camera": "^8.0.2",
    "@capacitor/core": "^8.2.0",
    "@capacitor/preferences": "^8.0.1",
    "leaflet": "^1.9.4",
    "onesignal-cordova-plugin": "^5.3.4",
    "react": "^19.0.0",
    "react-day-picker": "^9.8.1",
    "react-dom": "^19.0.0",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.26.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@types/leaflet": "^1.9.20",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.3"
  }
}
